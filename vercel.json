{
  "version": 2,
  "functions": {
    "api/list-files.js": {
      "includeFiles": "file-index.json"
    }
  },
  "routes": [
    {
      "src": "/api/list-files",
      "dest": "/api/list-files.js"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    }
  ],
  "headers": [
    {
      "source": "/(video|anime|vintage)/(.*)\\.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
