{
  "version": 2,
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/api/random",
      "dest": "/api/random.js"
    },
    {
      "src": "/api/random-playlist",
      "dest": "/api/random-playlist.js"
    },
    {
      "src": "/api/playlist-tracks",
      "dest": "/api/playlist-tracks.js"
    },
    {
      "src": "/api/mixtape/generate",
      "dest": "/api/mixtape/generate.js"
    },
    {
      "src": "/api/mixtape/save",
      "dest": "/api/mixtape/save.js"
    },
    {
      "src": "/api/mixtape/:id",
      "dest": "/api/mixtape/[id].js"
    }
  ],
  "headers": [
    {
      "source": "/(video|anime|vintage)/(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
